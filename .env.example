# Copy to .env.local and fill in from Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" key, or the newer "Publishable" key (sb_publishable_...). Safe to expose.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key, or the newer "Secret" key (sb_secret_...). Server only, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Default admin account, created by `npm run admin:create`.
# The first login forces a password change; change the email to a real one from the admin settings.
ADMIN_EMAIL=admin@rivera.local
ADMIN_PASSWORD=

# Optional: public address for QR codes once a custom domain exists. Defaults to the host the admin uses.
NEXT_PUBLIC_SITE_URL=
